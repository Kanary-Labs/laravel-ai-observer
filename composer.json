{
    "name": "kanary/laravel-ai-observatory",
    "description": "Local observability and debugging for applications using the official Laravel AI SDK.",
    "keywords": [
        "ai",
        "laravel",
        "observability"
    ],
    "homepage": "https://github.com/Kanary-Labs/laravel-ai-observer",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "laravel/ai": "^0.10.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.8",
        "laravel/pint": "^1.26",
        "orchestra/testbench": "^10.6 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Kanary\\AiObservatory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kanary\\AiObservatory\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --memory-limit=-1",
        "check": [
            "@test",
            "@test:lint",
            "@test:types"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kanary\\AiObservatory\\AiObservatoryServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
